# ============================================================================
# Copier en `.env` puis remplir.  NE JAMAIS COMMITER `.env`.
#   cp .env.example .env
# Générer les secrets avec :  openssl rand -base64 48
# ============================================================================

# --- PostgreSQL -------------------------------------------------------------
DB_USER=aero
DB_PASSWORD=CHANGEZ_MOI_openssl_rand
HUB_DB_NAME=hub

# --- Hub --------------------------------------------------------------------
# Clé secrète Django (ne change plus jamais ensuite : elle signe les sessions)
HUB_SECRET_KEY=CHANGEZ_MOI_openssl_rand
# Mot de passe partagé des membres (celui qu'on se passe à l'oral)
HUB_SHARED_PASSWORD=CHANGEZ_MOI
# Mot de passe admin (suppressions, archivage) — connu du bureau du pôle
HUB_ADMIN_PASSWORD=CHANGEZ_MOI_AUSSI
# Domaine public du Hub tel que servi par le reverse proxy (CSV)
HUB_ALLOWED_HOSTS=localhost,127.0.0.1
# Origines de confiance pour le CSRF (CSV, avec le schéma)
HUB_CSRF_ORIGINS=http://localhost:8081
# Port local écouté (le reverse proxy tape dessus)
HUB_PORT=8081

# --- Sauvegardes (scripts/backup.sh) ----------------------------------------
# Clé PUBLIQUE age du responsable des sauvegardes.
# La clé PRIVÉE ne doit JAMAIS se trouver sur le serveur.
BACKUP_AGE_RECIPIENT=age1CHANGEZMOI...
BACKUP_KEEP_DAYS=14
